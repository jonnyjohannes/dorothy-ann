{
  "name": "dorothy-ann",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msw@2.15.0": false,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "dev:server": "tsx server/runtime/node.ts",
    "build": "tsc --noEmit --pretty false && tsc -b tsconfig.build.json && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false && tsc -b tsconfig.build.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "auth:hash": "tsx scripts/auth-hash.ts",
    "secrets:generate": "tsx scripts/secrets-generate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hono/node-server": "^1.19.0",
    "@mozilla/readability": "^0.6.0",
    "@react-aria/button": "^3.14.0",
    "@react-aria/dialog": "^3.5.0",
    "@react-aria/focus": "^3.21.0",
    "@react-aria/textfield": "^3.18.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.3",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^17.4.2",
    "eventsource-parser": "^3.0.6",
    "fzf": "0.5.2",
    "hono": "^4.9.7",
    "idb": "^8.0.3",
    "linkedom": "^0.18.12",
    "react": "^19.1.1",
    "react-aria-components": "^1.12.0",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.8.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "undici": "^8.10.2",
    "xstate": "^5.20.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.1.0",
    "jsdom": "^30.1.1",
    "msw": "^2.11.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.4",
    "vitest": "^5.0.2"
  }
}
