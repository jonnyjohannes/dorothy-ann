DOROTHY_FIXTURE_MODE=true
# Structured server logging. Use debug for local research diagnostics.
LOG_LEVEL=info
# Opt-in server log: bounded timings, counts, and terminal enums only; never request/provider content.
RESEARCH_TIMING_LOGS=false
ANTHROPIC_API_KEY=
ANTHROPIC_ASSESSMENT_MODEL=
ANTHROPIC_SYNTHESIS_MODEL=
ANTHROPIC_WORKSPACE_ID=
BRAVE_SEARCH_API_KEY=
APP_PASSPHRASE_SCRYPT_HASH=
SESSION_SIGNING_KEYS=
LIMITER_KEY_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

MAX_SEARCH_RESULTS=10
MAX_CONCURRENT_SEARCHES=3
MAX_CONCURRENT_EXTRACTIONS=3
EXTRACTION_TIMEOUT_MS=8000
MAX_FETCH_BYTES=2000000
MAX_REDIRECTS=5
MAX_EXTRACTED_CHARS_PER_PAGE=20000
MAX_EVIDENCE_CHARS_PER_SOURCE=4000
MAX_EVIDENCE_CHARS_TOTAL=48000
MAX_THREAD_CONTEXT_TURNS=8
MAX_THREAD_CONTEXT_CHARS=24000
MAX_ASSESSMENT_OUTPUT_TOKENS=800
# Second attempt only after an assessment response stops at max_tokens (800-1600).
MAX_ASSESSMENT_RETRY_OUTPUT_TOKENS=1600
MAX_OUTPUT_TOKENS=4096
MAX_TURN_REQUEST_BYTES=128000

LOGIN_ATTEMPTS_PER_15_MIN=5
GLOBAL_LOGIN_ATTEMPTS_PER_HOUR=100

# v1.1 compatibility only; remove after migrating to the canonical names above.
